{
  "name": "faultline",
  "version": "0.1.0",
  "description": "TypeScript CLI for USGS significant earthquakes: filter, sort, and print the free day or week feed. No API key.",
  "keywords": [
    "earthquakes",
    "usgs",
    "geojson",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MechStudents2029/faultline.git"
  },
  "homepage": "https://github.com/MechStudents2029/faultline#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "quakes": "tsx src/quakes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
